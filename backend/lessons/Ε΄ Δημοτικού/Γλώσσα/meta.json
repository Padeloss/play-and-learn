{
  "grade": "Ε΄ Δημοτικού",
  "source": "«Η γλώσσα μας» Ε΄ Δημοτικού (Φλιάτουρας κ.ά., ΙΕΠ) — ερωτήσεις ανά ενότητα του βιβλίου",
  "chapters": [
    {
      "id": "u1",
      "num": "1",
      "title": "Πόσο μοναδικοί και μοναδικές είμαστε;",
      "unit": "Α΄ τεύχος"
    },
    {
      "id": "u2",
      "num": "2",
      "title": "Πώς εκφραζόμαστε δημιουργικά;",
      "unit": "Α΄ τεύχος"
    },
    {
      "id": "u3",
      "num": "3",
      "title": "Πώς φροντίζουμε μια καρδιά;",
      "unit": "Α΄ τεύχος"
    },
    {
      "id": "u4",
      "num": "4",
      "title": "Πόσο ζωντανός είναι ο ψηφιακός κόσμος;",
      "unit": "Β΄ τεύχος"
    },
    {
      "id": "u5",
      "num": "5",
      "title": "Τι υπάρχει στη Γη και έξω από αυτή;",
      "unit": "Β΄ τεύχος"
    },
    {
      "id": "u6",
      "num": "6",
      "title": "Γιατί είναι καλό να συμμετέχουμε;",
      "unit": "Β΄ τεύχος"
    },
    {
      "id": "u7",
      "num": "7",
      "title": "Γιατί μία γλώσσα δεν είναι αρκετή;",
      "unit": "Γ΄ τεύχος"
    },
    {
      "id": "u8",
      "num": "8",
      "title": "Πώς η λογοτεχνία «γιορτάζει» τη φιλία",
      "unit": "Γ΄ τεύχος"
    }
  ]
}
