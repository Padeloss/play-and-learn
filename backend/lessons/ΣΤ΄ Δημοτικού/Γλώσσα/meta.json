{
  "grade": "ΣΤ΄ Δημοτικού",
  "source": "«Η γλώσσα μας» ΣΤ΄ Δημοτικού (Οικονομάκου κ.ά., ΙΕΠ) — ερωτήσεις ανά ενότητα του βιβλίου",
  "chapters": [
    {
      "id": "u1",
      "num": "1",
      "title": "Μπορούμε να βελτιώσουμε την ποιότητα της ζωής μας;",
      "unit": "Α΄ τεύχος"
    },
    {
      "id": "u2",
      "num": "2",
      "title": "Ποια είναι τα όρια της επικοινωνίας;",
      "unit": "Α΄ τεύχος"
    },
    {
      "id": "u3",
      "num": "3",
      "title": "Έχει για όλα απαντήσεις η επιστήμη;",
      "unit": "Α΄ τεύχος"
    },
    {
      "id": "u4",
      "num": "4",
      "title": "Μετακινούμαστε και εξυπηρετούμαστε ισότιμα;",
      "unit": "Β΄ τεύχος"
    },
    {
      "id": "u5",
      "num": "5",
      "title": "Το μέλλον μας είναι εδώ;",
      "unit": "Β΄ τεύχος"
    },
    {
      "id": "u6",
      "num": "6",
      "title": "Γιατί μας αρέσουν οι ταινίες;",
      "unit": "Β΄ τεύχος"
    },
    {
      "id": "u7",
      "num": "7",
      "title": "Πόσο διαφέρουν τα ελληνικά μας;",
      "unit": "Γ΄ τεύχος"
    },
    {
      "id": "u8",
      "num": "8",
      "title": "Πώς ο χρόνος επιδρά στη γλώσσα;",
      "unit": "Γ΄ τεύχος"
    }
  ]
}
